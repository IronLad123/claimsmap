# LLM Provider: "ollama" (free local) or "gemini" (cloud)
LLM_PROVIDER=ollama

# Ollama local settings (100% free, runs on Mac)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Gemini settings (optional cloud alternative)
GEMINI_API_KEY=

# App settings
DEMO_MODE=false
SQLITE_DB_PATH=data/facts.db

